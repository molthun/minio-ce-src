# ==========================================================================
#  Pinned upstream versions — single source of truth for the whole build.
#  Change here, re-run scripts/build-all.sh, re-verify, re-package.
# ==========================================================================

# --- Go toolchain ---
GO_VERSION=1.26.4

# --- MinIO server (official upstream CE) ---
MINIO_REPO=https://github.com/minio/minio.git
MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a

# --- MinIO client mc (official upstream) ---
MC_REPO=https://github.com/minio/mc.git
MC_TAG=RELEASE.2025-08-13T08-35-41Z
MC_COMMIT=7394ce0dd2a80935aded936b09fa12cbb3cb8096

# --- Full web console (opens3/console fork + its mds fork) ---
CONSOLE_REPO=https://github.com/opens3/console.git
CONSOLE_COMMIT=78fe28aac68393f3762899b544bccd4b5b2f616e

# --- Security dependency bumps applied to minio go.mod (see scripts/20-patch-minio.sh) ---
BUMP_X_CRYPTO=v0.52.0
BUMP_X_NET=v0.55.0
BUMP_GO_JOSE=v4.1.4
BUMP_OTEL_SDK=v1.40.0
BUMP_PAHO_MQTT=v1.5.1

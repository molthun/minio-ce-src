# ============================================================
#  MinIO server (official CE / upstream build) — environment
#  File location on target: /etc/minio/minio.env  (mode 0640, root:minio)
# ============================================================

# --- Root credentials (the web-console admin login) ---
# Do NOT leave defaults. install.sh generates strong values automatically.
MINIO_ROOT_USER=CHANGE-ME-admin
MINIO_ROOT_PASSWORD=CHANGE-ME-long-random-secret

# --- Data volume ---
# Point this at the mounted Proxmox datastore disk (single-node single-drive).
# The mount must exist and be owned by the 'minio' user before start.
MINIO_VOLUMES=/mnt/minio/data

# --- Listen addresses ---
#  :9000              -> S3 API, reachable on the VM IP  (ip:9000)
#  127.0.0.1:9001     -> minio's built-in (stripped) console, kept LOCAL only
#                        so it does not conflict with the full opens3 console.
MINIO_OPTS=--address :9000 --console-address 127.0.0.1:9001

# --- Optional ---
# MINIO_REGION=us-east-1
# MINIO_SERVER_URL=http://<VM-IP>:9000

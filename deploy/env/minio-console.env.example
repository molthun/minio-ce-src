# ============================================================
#  Full web console (opens3/console fork) — environment
#  File location on target: /etc/minio/minio-console.env  (mode 0640, root:minio)
# ============================================================

# The console proxies the local MinIO admin/S3 API. Keep this on localhost.
CONSOLE_MINIO_SERVER=http://127.0.0.1:9000

# Secrets used to encrypt console session cookies. MUST be long and random.
# install.sh fills these with `openssl rand -hex 32` automatically.
CONSOLE_PBKDF_PASSPHRASE=CHANGE-ME-openssl-rand-hex-32
CONSOLE_PBKDF_SALT=CHANGE-ME-openssl-rand-hex-32

# Bind is set in the systemd unit: --host 0.0.0.0 --port 9090  (admin UI at ip:9090)
